{
  "mutate": [
    "src/lib/feeComputation.ts",
    "src/lib/lossAllocation.ts"
  ],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "reporters": [
    "html",
    "json",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/money-math/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/money-math/mutation-report.json"
  },
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 80
  },
  "tsconfigFile": "tsconfig.json",
  "ignoreStatic": true,
  "timeoutMS": 10000,
  "timeoutFactor": 2,
  "concurrency": 2,
  "disableBail": false,
  "plugins": [
    "@stryker-mutator/jest-runner"
  ],
  "checkers": []
}
